# Copier en .env (ignoré par git) et remplir. Jamais de valeur réelle dans ce fichier.
# Jeton long de la CLI claude : `claude setup-token` sur un appareil connecté.
CLAUDE_CODE_OAUTH_TOKEN=
# Identifiant du propriétaire du dossier partagé : `id -u` et `id -g`.
PUID=
PGID=
PORT=
# Adresse du NAS sur le réseau local, à ouvrir depuis un autre appareil (ex. 192.168.1.20:3000).
ADRESSE_PUBLIQUE=
# Chemins dans le conteneur ; laisser vide pour les valeurs par défaut.
TEACH_SKILL_DIR=
ELEVES_DIR=
